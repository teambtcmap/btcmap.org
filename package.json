{
	"name": "btcmap",
	"version": "1.0.0",
	"private": true,
	"description": "Find places to spend sats wherever you are.",
	"repository": "https://github.com/teambtcmap/btcmap.org",
	"author": "secondl1ght <secondl1ght@protonmail.com>",
	"license": "AGPL-3.0",
	"engines": {
		"node": ">=22.13"
	},
	"type": "module",
	"scripts": {
		"build": "pnpm run sync:rtl-plugin && vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "pnpm run sync:rtl-plugin && vite dev --host",
		"format": "biome check src",
		"format:fix": "biome format --write src",
		"lint": "biome check src",
		"lint:fix": "biome check --write src",
		"prepare": "husky",
		"preview": "vite preview",
		"sync:rtl-plugin": "cp node_modules/@mapbox/mapbox-gl-rtl-text/dist/mapbox-gl-rtl-text.js static/mapbox-gl-rtl-text.js",
		"test": "vitest",
		"types:api": "rm -rf src/types/btcmap-api && npx degit teambtcmap/btcmap-api/bindings/ts src/types/btcmap-api",
		"typecheck": "tsc --project ./tsconfig.json --noEmit --pretty"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"biome check --write --no-errors-on-unmatched"
		],
		"*.{json,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"dependencies": {
		"@mapbox/geojson-rewind": "^0.5.2",
		"@nazka/map-gl-js-spiderfy": "^2.0.0",
		"@tanstack/match-sorter-utils": "^9.1.2",
		"@tanstack/svelte-table": "^9.2.4",
		"axios": "^1.15.0",
		"axios-retry": "^4.5.0",
		"chart.js": "^4.5.1",
		"d3-geo": "^3.1.1",
		"date-fns": "^4.3.0",
		"dompurify": "^3.4.14",
		"globals": "^17.11.0",
		"husky": "^9.1.7",
		"i18n-iso-countries": "^7.14.0",
		"js-confetti": "^0.13.1",
		"localforage": "^1.10.0",
		"maplibre-gl": "^6.6.0",
		"marked": "^18.0.10",
		"nostr-tools": "^2.24.3",
		"opening_hours": "^3.13.0",
		"qrcode": "^1.5.4",
		"svelte-i18n": "^4.0.1",
		"svelte-outclick": "^4.2.0",
		"svelte-sonner": "^1.2.1",
		"svelte-time": "^2.3.1",
		"svg-captcha": "^1.4.0",
		"tippy.js": "^6.3.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@iconify/svelte": "^5.2.2",
		"@mapbox/mapbox-gl-rtl-text": "^0.4.0",
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/postcss": "^4.3.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/d3-geo": "^3.1.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^22.20.1",
		"@types/qrcode": "^1.5.6",
		"jsdom": "^30.0.1",
		"lint-staged": "^17.3.0",
		"postcss": "^8.5.26",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@11.21.0"
}
